PORT=4173
HOST=0.0.0.0
DATA_DIR=./data
MAX_DB_BYTES=1073741824

# Optional: persistent cloud storage without a paid Render disk.
# Keep the service role key only in server environment variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=sales-analytics
SUPABASE_DB_OBJECT=sales-analytics.sqlite

# Server-only Supabase Postgres access for management screens and internal APIs.
SUPABASE_POSTGRES_URL=
SUPABASE_POSTGRES_SERVICE_ROLE_KEY=

# Optional but recommended for the internal price audit API.
# Send it as: Authorization: Bearer <key> or x-api-key: <key>
PRICE_AUDIT_API_KEY=
